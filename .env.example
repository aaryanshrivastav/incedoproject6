# App
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Datastores (Supabase PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0

# LLM provider (see docs/DECISIONS.md D-006)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
REFUSAL_MIN_SCORE=0.0
ON_UNCITED=retry
SNIPPET_MAX_CHARS=240

# Embeddings (dimension must match the model; migrations read this)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Reranker
RERANKER_PROVIDER=
RERANKER_MODEL=

# Ingestion / OCR
OCR_LANG=eng
OCR_CHAR_THRESHOLD=25

# Retrieval
RETRIEVAL_VECTOR_K=50
RETRIEVAL_FTS_K=50
RETRIEVAL_FUSED_K=30
RETRIEVAL_RRF_K=60
RETRIEVAL_HNSW_EF_SEARCH=
RERANK_ENABLED=true
RERANK_TOP_N=8
CONTEXT_BUDGET_TOKENS=3000
CONTEXT_EXPAND_PARENTS=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Evaluation Judge (Phase 3.2; see docs/DECISIONS.md D-011)
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen2.5:3b
JUDGE_API_KEY=
JUDGE_BASE_URL=http://localhost:11435

# Auth
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256

# Observability (Phase 6)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
