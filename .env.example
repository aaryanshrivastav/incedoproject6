# App
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Datastores
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5433/kb
REDIS_URL=redis://localhost:6379/0

# LLM provider (see docs/DECISIONS.md D-006; confirm before Phase 0)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Embeddings (dimension must match the model; migrations read this)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Reranker
RERANKER_PROVIDER=
RERANKER_MODEL=

# Ingestion / OCR
OCR_LANG=eng
OCR_CHAR_THRESHOLD=25

# Auth
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256

# Observability (Phase 6)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
