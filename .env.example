# App
APP_ENV=local
LOG_LEVEL=INFO

# Datastores
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb
REDIS_URL=redis://localhost:6379/0

# LLM provider (see docs/DECISIONS.md D-006; confirm before Phase 0)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Embeddings (dimension must match the model; migrations read this)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Reranker
RERANKER_PROVIDER=
RERANKER_MODEL=

# Auth
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256

# Observability (Phase 6)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
